# Copy to a local .env file (ignored by Git) and load it in your product test runner.
# Use the direct Unified Interface URL copied from Power Apps.
DATAVERSE_APP_URL=https://YOUR-ENVIRONMENT.crm.dynamics.com/main.aspx?appid=YOUR-APP-ID

# Local interactive auth setup only: choose a selector confirmed on your app.
DATAVERSE_READY_SELECTOR=YOUR-VERIFIED-CSS-SELECTOR
