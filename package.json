{
  "name": "dvtestforge-framework",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Central Playwright TypeScript framework for Microsoft Dataverse model-driven applications",
  "engines": { "node": ">=22" },
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "peerDependencies": { "@playwright/test": "^1.56.0" },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4"
  }
}
